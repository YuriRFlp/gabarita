        "fuga ao conteúdo",
        "letra ilegível",
        "lápis",
        "identificação indevida"
      ]
    },
    "fcc_redacao": {
      "criterios": [
        {
          "id": "recorte",
          "nome": "Recorte temático",
          "max": 2
        },
        {
          "id": "textos_apoio",
          "nome": "Interpretação crítica dos textos de apoio",
          "max": 2
        },
        {
          "id": "progressao",
          "nome": "Progressão textual",
          "max": 3
        },
        {
          "id": "vocabulario",
          "nome": "Propriedade vocabular",
          "max": 0.8
        },
        {
          "id": "coesao",
          "nome": "Coesão textual",
          "max": 1.6
        },
        {
          "id": "morfossintaxe",
          "nome": "Morfossintaxe",
          "max": 0.6
        }
      ],
      "zera_se": [
        "fuga ao tema ou ao gênero",
        "até 7 linhas",
        "identificação",
        "cópia de modelos prontos"
      ]
    },
    "ibfc_estudo_caso": {
      "criterios": [
        {
          "id": "estrutura",
          "nome": "Estrutura dissertativo-argumentativa",
          "max": 10
        },
        {
          "id": "conteudo",
          "nome": "Conteúdo: fidelidade ao tema, argumentação, senso crítico",
          "max": 20
        },
        {
          "id": "expressao",
          "nome": "Expressão: norma culta, clareza, coesão",
          "max": 10
        }
      ],
      "zera_se": [
        "nota zero em qualquer critério elimina"
      ]
    },
    "cebraspe_redacao": {
      "formula": "NPD = NC - 4 * NE / TL",
      "NC_max": 20,
      "legenda": {
        "NC": "nota de conteúdo",
        "NE": "número de erros de língua",
        "TL": "linhas escritas"
      },
      "variante_tecnica": {
        "uso": "questão dissertativa técnica de até 45 linhas (cargos específicos)",
        "formula": "NPD = NC - 6 * NE / TL",
        "NC_max": 30
      }
    }
  },
