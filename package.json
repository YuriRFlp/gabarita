{
  "name": "gabarita",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "imports": {
    "#factories/*": "./tests/factories/*.ts"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "supabase db reset && playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/shared/supabase/database.types.ts",
    "tokens": "node scripts/generate-tokens-css.ts",
    "e2e:user": "node scripts/create-test-user.ts",
    "db:link": "supabase link --project-ref",
    "db:push": "node scripts/push-migrations.ts",
    "db:test:remote": "node scripts/test-remote.ts",
    "backup": "node scripts/backup-db.ts",
    "backup:verify": "node scripts/verify-backup.ts",
    "check:prod": "node scripts/check-production.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.5.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
